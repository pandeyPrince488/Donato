extends layout

block content
  style.
    /* Home page only — let the hero break out of the centered container */
    .main-content { padding-top: 0 !important; padding-bottom: 0 !important; max-width: 100%; }
    .home-shell { max-width: 1180px; margin: 0 auto; padding: 0 1.5rem; }
    .home-bg {
      position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background: var(--grad-mesh);
    }
    .spline-mount {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 100%; height: 110%;
      z-index: -1;
      pointer-events: none;
      opacity: 0.85;
      mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);
    }
    spline-viewer { width: 100% !important; height: 100% !important; background: transparent !important; }
    spline-viewer::part(logo) { display: none !important; }

    .floaty {
      position: absolute;
      pointer-events: none;
      filter: blur(0.5px);
      opacity: 0.55;
      animation: float 9s ease-in-out infinite;
    }
    .floaty-1 { top: 12%; left: 8%; font-size: 1.8rem; color: var(--accent); animation-delay: -1s; }
    .floaty-2 { top: 22%; right: 11%; font-size: 1.4rem; color: var(--brand); animation-delay: -3s; }
    .floaty-3 { bottom: 18%; left: 14%; font-size: 1.6rem; color: var(--accent-warm); animation-delay: -5s; }
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0); }
      50%      { transform: translateY(-22px) rotate(8deg); }
    }

    /* Mini "how it works" strip */
    .feature-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.4rem;
      margin: 4rem 0 5rem;
      @media (max-width: 800px) { grid-template-columns: 1fr; }
    }
    .feature-card {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 1.8rem;
      transition: all 0.25s var(--ease);
      position: relative;
      overflow: hidden;
    }
    .feature-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(229,35,44,0.18);
    }
    .feature-card .icon {
      width: 46px; height: 46px;
      border-radius: 14px;
      background: var(--brand-soft);
      color: var(--brand);
      display: grid; place-items: center;
      font-size: 1.3rem;
      margin-bottom: 1rem;
    }
    .feature-card h3 {
      font-size: 1.15rem; margin: 0 0 0.4rem;
      letter-spacing: -0.01em;
    }
    .feature-card p {
      color: var(--fg-muted);
      font-size: 0.92rem;
      line-height: 1.55;
      margin: 0;
    }
    .feature-card .badge-pos {
      position: absolute; top: 1rem; right: 1rem;
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--brand);
      background: var(--brand-soft);
      padding: 3px 9px;
      border-radius: 999px;
      letter-spacing: 0.04em;
    }

  .home-bg
  .spline-mount
    script(type="module" src="https://unpkg.com/@splinetool/viewer/build/spline-viewer.js")
    spline-viewer(url="https://prod.spline.design/Xg5ob7muFX-xqvoL/scene.splinecode" background="transparent" events-target="global")

  section.hero-modern
    i.fas.fa-tint.floaty.floaty-1
    i.fas.fa-heartbeat.floaty.floaty-2
    i.fas.fa-shield-heart.floaty.floaty-3

    .home-shell
      span.hero-eyebrow
        span.live-dot(style='background: var(--brand);')
        | AI-powered blood-donor matching · live now

      h1.hero-headline
        | Find a compatible donor 
        span.gradient-text in seconds.
      p.hero-sub
        | Donato pairs a real-time donor matcher with a knowledge-grounded eligibility assistant.
        | Built on a Python AI service with vector retrieval, an LLM-explained ranker, and a C++ hot path.

      if !user
        .hero-cta
          a.btn.btn-primary.btn-lg(href='/signup')
            i.fas.fa-bolt.me-2
            | Get started
          a.btn.btn-outline-primary.btn-lg(href='/login')
            i.fas.fa-arrow-right-to-bracket.me-2
            | Log in
      else
        .hero-cta
          a.btn.btn-primary.btn-lg(href='/donors/smart')
            i.fas.fa-bolt.me-2
            | Try Smart Match
          a.btn.btn-outline-primary.btn-lg(href='/account')
            i.fas.fa-user-gear.me-2
            | Profile

      .hero-tech-row
        span.chip.chip-tech
          i.fas.fa-brain
          | RAG · vector retrieval
        span.chip.chip-tech
          i.fas.fa-microchip
          | ONNX MiniLM
        span.chip.chip-tech
          i.fas.fa-bolt-lightning
          | Groq Llama-3.1-8B
        span.chip.chip-tech
          i.fas.fa-code
          | C++ pybind11 hot path
        span.chip.chip-tech
          i.fas.fa-shield-halved
          | Strict context-only LLM

      .hero-stats
        .hero-stat
          .stat-num.tabular(data-target='13', data-suffix='') 13
          .stat-label Eligibility chunks indexed for chatbot retrieval
        .hero-stat
          .stat-num.tabular(data-target='99', data-suffix='ms') 99ms
          .stat-label Average chatbot retrieval latency (ONNX MiniLM)
        .hero-stat
          .stat-num.tabular(data-target='8', data-suffix='') 8
          .stat-label Blood groups matched with hard compatibility gates

  .home-shell
    .feature-strip
      .feature-card
        span.badge-pos AI
        .icon
          i.fas.fa-magnifying-glass-chart
        h3 Smart Donor Matcher
        p Distance, freshness, response history, blood compatibility &amp; recency are scored, top-K reranked, then a single batched LLM call writes a one-line "why this donor" reason.

      .feature-card
        span.badge-pos RAG
        .icon
          i.fas.fa-comment-medical
        h3 Eligibility Assistant
        p A floating chatbot grounded in WHO/Red Cross-style donor rules. MiniLM embeddings + Chroma vector store + a refusal threshold keep it from hallucinating.

      .feature-card
        span.badge-pos C++
        .icon
          i.fas.fa-bolt
        h3 Hot Path in C++
        p Per-candidate Haversine distance batched in C++ via pybind11, with a graceful pure-Python fallback if the build fails. Up to ~5× faster than the Python path on benchmark.

  script.
    // Count-up the hero stats once they enter the viewport.
    document.addEventListener('DOMContentLoaded', function() {
      var nums = document.querySelectorAll('.hero-stat .stat-num[data-target]');
      var animateCounter = function(el) {
        var target = parseInt(el.getAttribute('data-target'), 10);
        var suffix = el.getAttribute('data-suffix') || '';
        var start = 0;
        var dur = 1100;
        var t0 = performance.now();
        var step = function(now) {
          var p = Math.min(1, (now - t0) / dur);
          // ease out
          var v = Math.round(target * (1 - Math.pow(1 - p, 3)));
          el.textContent = v + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (e.isIntersecting) {
              animateCounter(e.target);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.5 });
        nums.forEach(function(n) { io.observe(n); });
      } else {
        nums.forEach(animateCounter);
      }

      // Best-effort hide of Spline watermark
      var viewer = document.querySelector('spline-viewer');
      var clean = function() {
        document.querySelectorAll('[part="logo"], .logo, .watermark').forEach(function(el) { el.remove(); });
        if (viewer && viewer.shadowRoot) {
          var l = viewer.shadowRoot.querySelector('[part="logo"], .logo, .watermark');
          if (l) l.remove();
        }
      };
      [600, 1500, 3000].forEach(function(t) { setTimeout(clean, t); });
    });
