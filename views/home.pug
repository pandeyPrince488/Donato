extends layout

block content
  style.
    /* Home page only — let the hero break out of the centered container */
    .main-content { padding-top: 0 !important; padding-bottom: 0 !important; max-width: 100%; }
    .home-shell { max-width: 1180px; margin: 0 auto; padding: 0 1.5rem; }
    .home-bg {
      position: fixed; inset: 0; z-index: -1; pointer-events: none;
      background: var(--grad-mesh);
    }
    .spline-mount {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 100%; height: 110%;
      z-index: -1;
      pointer-events: none;
      opacity: 0.85;
      mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse at center, black 35%, transparent 75%);
    }
    spline-viewer { width: 100% !important; height: 100% !important; background: transparent !important; }
    spline-viewer::part(logo) { display: none !important; }

    .floaty {
      position: absolute;
      pointer-events: none;
      filter: blur(0.5px);
      opacity: 0.55;
      animation: float 9s ease-in-out infinite;
    }
    .floaty-1 { top: 12%; left: 8%; font-size: 1.8rem; color: var(--accent); animation-delay: -1s; }
    .floaty-2 { top: 22%; right: 11%; font-size: 1.4rem; color: var(--brand); animation-delay: -3s; }
    .floaty-3 { bottom: 18%; left: 14%; font-size: 1.6rem; color: var(--accent-warm); animation-delay: -5s; }
    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(0); }
      50%      { transform: translateY(-22px) rotate(8deg); }
    }

    /* Three-step "how it works" */
    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.4rem;
      margin: 4rem 0 1.5rem;
      @media (max-width: 800px) { grid-template-columns: 1fr; }
    }
    .step {
      background: var(--bg-elev);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      padding: 1.8rem;
      position: relative;
      transition: all 0.25s var(--ease);
    }
    .step:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(229,35,44,0.18);
    }
    .step-num {
      position: absolute;
      top: -14px; left: 1.4rem;
      width: 32px; height: 32px;
      background: var(--grad-brand);
      color: white;
      border-radius: 50%;
      display: grid; place-items: center;
      font-weight: 700;
      font-size: 0.92rem;
      box-shadow: 0 4px 12px -2px rgba(229,35,44,0.4);
    }
    .step h3 {
      font-size: 1.1rem;
      margin: 0.4rem 0 0.5rem;
      letter-spacing: -0.01em;
    }
    .step p {
      color: var(--fg-muted);
      font-size: 0.92rem;
      line-height: 1.55;
      margin: 0;
    }

    /* Subtle "made with" strip near the bottom — for recruiters, not the spotlight */
    .made-with {
      margin: 5rem 0 2rem;
      padding: 1.6rem;
      background: var(--bg-muted);
      border: 1px dashed var(--border-strong);
      border-radius: var(--r-lg);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      text-align: center;
    }
    .made-with-label {
      color: var(--fg-muted);
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      margin-right: 0.4rem;
    }

  .home-bg
  .spline-mount
    script(type="module" src="https://unpkg.com/@splinetool/viewer/build/spline-viewer.js")
    spline-viewer(url="https://prod.spline.design/Xg5ob7muFX-xqvoL/scene.splinecode" background="transparent" events-target="global")

  section.hero-modern
    i.fas.fa-tint.floaty.floaty-1
    i.fas.fa-heartbeat.floaty.floaty-2
    i.fas.fa-shield-heart.floaty.floaty-3

    .home-shell
      span.hero-eyebrow
        span.live-dot(style='background: var(--brand);')
        | Smart blood-donor matching · live now

      h1.hero-headline
        | Find a compatible donor 
        span.gradient-text in seconds.

      p.hero-sub
        | Donato matches you with the right blood donors near you, instantly.
        | Built for the moments when every minute counts.

      if !user
        .hero-cta
          a.btn.btn-primary.btn-lg(href='/signup')
            i.fas.fa-bolt.me-2
            | Get started — it's free
          a.btn.btn-outline-primary.btn-lg(href='/login')
            i.fas.fa-arrow-right-to-bracket.me-2
            | Log in
      else
        .hero-cta
          a.btn.btn-primary.btn-lg(href='/donors/smart')
            i.fas.fa-bolt.me-2
            | Find a donor now
          a.btn.btn-outline-primary.btn-lg(href='/account')
            i.fas.fa-user-gear.me-2
            | My profile

  .home-shell
    .steps
      .step
        .step-num 1
        h3 Tell us about you
        p Your blood group and a rough location is all we need. Takes under a minute.
      .step
        .step-num 2
        h3 See ranked matches
        p Compatible donors near you, sorted by who is most likely to be available right now.
      .step
        .step-num 3
        h3 Reach out instantly
        p Message donors directly inside the app, or email them with one click.

    .made-with
      span.made-with-label Built with
      span.chip.chip-tech
        i.fas.fa-brain
        | Retrieval-augmented AI
      span.chip.chip-tech
        i.fas.fa-shield-halved
        | WHO/Red Cross eligibility rules
      span.chip.chip-tech
        i.fas.fa-bolt-lightning
        | Real-time matching

  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Best-effort hide of Spline watermark
      var viewer = document.querySelector('spline-viewer');
      var clean = function() {
        document.querySelectorAll('[part="logo"], .logo, .watermark').forEach(function(el) { el.remove(); });
        if (viewer && viewer.shadowRoot) {
          var l = viewer.shadowRoot.querySelector('[part="logo"], .logo, .watermark');
          if (l) l.remove();
        }
      };
      [600, 1500, 3000].forEach(function(t) { setTimeout(clean, t); });
    });
