doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='theme-color' content='#E5232C')
    title #{title} - Donato
    link(rel='stylesheet' href='/css/main.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css')
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap')
    block head
    style.
      body {
        padding-top: 96px;
        min-height: 100vh;
      }
      .main-content { padding-top: 1.5rem; padding-bottom: 4rem; }
      .container { max-width: 1180px; }

  body
    include partials/header

    .container.main-content
      include partials/flash
      block content

    include partials/footer

    include partials/eligibility-chat

    script(src='/js/lib/jquery.min.js')
    script(src='/js/lib/bootstrap.bundle.min.js')
    script(src='/js/main.js')
    script(src='/js/eligibility-chat.js')
    block scripts
