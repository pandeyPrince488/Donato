//- Floating eligibility chatbot. Mounted globally via layout.pug so it follows
//- the user across every page. Behaviour lives in /js/eligibility-chat.js.

#eligibility-chat-root(aria-live='polite')
  button#eligibility-chat-toggle(type='button', aria-label='Open eligibility assistant', title='Ask about donor eligibility')
    i.fas.fa-comment-medical
  .eligibility-chat-panel#eligibility-chat-panel(hidden)
    .eligibility-chat-header
      div(style='line-height:1.2;')
        strong Eligibility Assistant
        .small Knowledge-grounded · not medical advice
      button.eligibility-chat-close#eligibility-chat-close(type='button', aria-label='Close')
        i.fas.fa-times
    .eligibility-chat-messages#eligibility-chat-messages
      .ec-msg.ec-msg-bot
        | Hi! Ask me anything about blood-donor eligibility. Try
        em.d-block.mt-1(style='color: var(--fg-muted); font-size: 0.85rem;') "Can I donate after a tattoo?" or "What's the minimum age?"
    form.eligibility-chat-form#eligibility-chat-form(autocomplete='off')
      input#eligibility-chat-input(type='text' placeholder='Ask about eligibility…' maxlength='500' required)
      button.btn.btn-primary.btn-sm(type='submit' aria-label='Send')
        i.fas.fa-paper-plane

style.
  #eligibility-chat-root {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 1050;
    font-family: inherit;
  }
  #eligibility-chat-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: none;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    transition: transform 0.2s var(--ease);
    position: relative;
  }
  #eligibility-chat-toggle:hover { transform: translateY(-3px) scale(1.05); }
  .eligibility-chat-panel {
    position: absolute;
    bottom: 78px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 40px);
    height: 520px;
    background: var(--bg-elev);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .eligibility-chat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }
  .eligibility-chat-close {
    background: transparent;
    border: none;
    font-size: 0.95rem;
    cursor: pointer;
    flex-shrink: 0;
  }
  .eligibility-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .eligibility-chat-messages::-webkit-scrollbar { width: 6px; }
  .eligibility-chat-messages::-webkit-scrollbar-thumb {
    background: var(--border-strong);
    border-radius: 999px;
  }
  .ec-msg {
    padding: 10px 14px;
    border-radius: 16px;
    max-width: 86%;
    word-wrap: break-word;
  }
  .ec-msg-user {
    align-self: flex-end;
  }
  .ec-msg-bot {
    align-self: flex-start;
    color: var(--fg);
  }
  .eligibility-chat-form {
    display: flex;
    gap: 8px;
    padding: 12px;
  }
  .eligibility-chat-form input {
    flex: 1;
    border-radius: var(--r-pill);
    padding: 0.55rem 1rem;
    font-size: 0.92rem;
    outline: none;
    background: var(--bg-muted);
  }
  .eligibility-chat-form .btn {
    width: 38px; height: 38px; padding: 0;
    border-radius: 50%;
    display: grid; place-items: center;
  }
