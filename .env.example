# =======================
# Donato (Node) — env vars
# =======================
# Copy to .env and fill in real values. Never commit .env.

# Server URL the app considers itself reachable at. Locally that's:
BASE_URL=http://localhost:8080
PORT=8080
NODE_ENV=development

# Long random string used to sign sessions.
SESSION_SECRET=please_change_me_to_something_long_and_random

# MongoDB connection string. Locally:
#   mongodb://localhost:27017/bloodchain
# In production (free tier on Atlas, see DEPLOY.md):
#   mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/bloodchain?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bloodchain

# =======================
# (Optional) SMTP for verification + password-reset emails
# =======================
# Easiest free providers:
#   - Brevo (formerly Sendinblue): smtp-relay.brevo.com  port 587  (300 emails/day free)
#   - Resend: smtp.resend.com  port 465  (100 emails/day, 3000/month free)
#   - Gmail App Password: smtp.gmail.com port 465  (requires 2FA + app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender address shown in the From: header of outgoing email.
# Defaults to SMTP_USER if unset.
SITE_CONTACT_EMAIL=

# =======================
# (Optional) Google OAuth Sign-In
# =======================
# Get these at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorized redirect URIs:  <BASE_URL>/auth/google/callback
# When both are set, a "Continue with Google" button appears on /login and /signup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =======================
# AI service (Python) — endpoints used by Node
# =======================
# Locally the Python service runs on port 8000:
AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_TOKEN in ai-service/.env -- shared secret.
AI_SERVICE_TOKEN=change_me_to_a_long_random_string
