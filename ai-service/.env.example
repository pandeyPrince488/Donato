# Copy this file to .env and fill in real values

# LLM (Groq — free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_replace_me
LLM_MODEL=llama-3.1-8b-instant

# Service config
AI_SERVICE_PORT=8000
AI_SERVICE_TOKEN=change_me_to_a_long_random_string

# RAG store location (persistent)
CHROMA_PERSIST_DIR=./data/chroma

# Optional: set to "true" to disable the C++ extension and force Python fallback
DISABLE_CPP_EXT=false
