extends layout

block content
  .section-heading
    span.section-eyebrow
      i.fas.fa-location-dot.me-2
      | Nearby
    h1.section-title Donors near you
    p.section-sub Filtered by blood compatibility within 45 km of your saved location.

  if !user
    .alert.alert-warning
      i.fas.fa-circle-exclamation.me-2
      | Please 
      a(href='/login') log in 
      | or 
      a(href='/signup') create an account 
      | to see donors with matching blood group and chat with them.
  else if !user.profile.bloodGroup
    .alert.alert-warning
      i.fas.fa-circle-exclamation.me-2
      | Please 
      a(href='/account') update your profile 
      | with your blood group to see matching donors.
  else if donors.length === 0
    .alert.alert-info
      i.fas.fa-circle-info.me-2
      | No donors found within 45 km with matching blood group.
      |  Try the 
      a(href='/donors/smart') Smart Match 
      | view — it widens the search and lets you tune the radius.
  else
    .row.g-4
      each donor in donors
        .col-md-6
          .card.donor-card
            .donor-head
              div(style='min-width:0; flex:1;')
                h3.donor-name= donor.profile.name || 'Anonymous Donor'
                .donor-meta
                  if donor.profile.location && donor.profile.location.address
                    | #{donor.profile.location.address}
                  else if donor.distance !== null
                    | #{donor.distance} km away
              span.bg-pill
                i.fas.fa-droplet
                | #{donor.profile.bloodGroup}

            if donor.distance !== null
              span.distance-pill
                i.fas.fa-route
                | #{donor.distance} km

            .d-flex.justify-content-end.gap-2.mt-2
              if donor.email
                a.btn.btn-ghost.btn-sm(href=`mailto:${donor.email}`)
                  i.fas.fa-envelope.me-1
                  | Email
              a.btn.btn-primary.btn-sm(href=`/chat?userId=${donor._id}`)
                i.fas.fa-comments.me-1
                | Chat

block scripts
  script.
    // (nothing yet)
