extends ../layout

block content
  .auth-shell
    .auth-card
      h2 Create your account
      p.auth-sub Start saving lives in your area. Takes under a minute.

      if googleOauthEnabled
        a.btn.btn-google-oauth(href='/auth/google')
          svg(width='18' height='18' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg' style='flex-shrink:0;')
            path(d='M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z' fill='#4285F4')
            path(d='M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z' fill='#34A853')
            path(d='M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z' fill='#FBBC05')
            path(d='M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z' fill='#EA4335')
          | Sign up with Google

        .auth-divider
          span or with email

      form#signup-form(method='POST')
        input(type='hidden', name='_csrf', value=_csrf)
        .mb-3
          label.form-label(for='email') Email
          input.form-control(type='email', name='email', id='email', placeholder='you@example.com', autofocus, autocomplete='email', required)
        .mb-3
          label.form-label(for='password') Password
          input.form-control(type='password', name='password', id='password', placeholder='At least 8 characters', autocomplete='new-password', minlength='8', required)
        .mb-3
          label.form-label(for='confirmPassword') Confirm password
          input.form-control(type='password', name='confirmPassword', id='confirmPassword', placeholder='Re-enter your password', autocomplete='new-password', minlength='8', required)
        button.btn.btn-success.mt-3(type='submit')
          i.fas.fa-user-plus.me-2
          | Create account

      .auth-footer
        | Already have an account? 
        a(href='/login') Sign in

      if smtpEnabled
        .text-center.mt-3
          small.text-muted-warm
            i.fas.fa-envelope-open-text.me-1
            | We'll send a verification link to your inbox after sign up.

  style.
    .btn-google-oauth {
      display: flex; align-items: center; justify-content: center;
      gap: 0.7rem; width: 100%;
      padding: 0.75rem 1.2rem;
      background: var(--bg-elev);
      border: 1.5px solid var(--border);
      border-radius: var(--r-pill);
      color: var(--fg);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s var(--ease);
      margin-bottom: 1rem;
    }
    .btn-google-oauth:hover {
      border-color: var(--accent);
      background: var(--bg-muted);
      transform: translateY(-1px);
      box-shadow: var(--shadow-sm);
      color: var(--fg);
    }
    .auth-divider {
      display: flex; align-items: center;
      gap: 0.8rem;
      margin: 1.2rem 0;
      color: var(--fg-faint);
      font-size: 0.8rem;
    }
    .auth-divider::before, .auth-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .auth-divider span { white-space: nowrap; }
